{
	"name": "traw/powermail-jira",
	"description": "Base extension - Post powermail form submissions as jira issues",
	"type": "typo3-cms-extension",
	"keywords": [
		"TYPO3 CMS",
		"Powermail",
		"Jira",
		"Issues"
	],
	"license": "GPL-3.0-or-later",
	"autoload": {
		"psr-4": {
			"TRAW\\PowermailJira\\": "Classes/"
		}
	},
	"require": {
		"typo3/cms-core": "^13.4",
		"in2code/powermail": "^13",
		"evoweb/extender": "^11"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "powermail_jira"
		}
	}
}
